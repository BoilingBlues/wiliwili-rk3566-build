Fix libmpv present timing for 1080p60 judder

1080p60 on a 60 Hz panel stutters when libmpv is told the frame is
on screen immediately after drawing into an FBO. The real present is
glfw/SDL SwapBuffers, one vsync later, so mpv's 60 fps pacing drifts.

Report swap after SwapBuffers, and restore video-timing-offset=0.050
(the previous value 0 was meant for 60 fps but made the late present
worse).

--- a/library/borealis/library/include/borealis/core/video.hpp
+++ b/library/borealis/library/include/borealis/core/video.hpp
@@ -77,4 +77,7 @@
     static inline int monitorIndex = 0;
 
     static inline int swapInterval = 1;
+
+    // Invoked after the platform presents a frame (SwapBuffers / SwapWindow).
+    static inline void (*swapCallback)() = nullptr;
 };
--- a/library/borealis/library/lib/platforms/glfw/glfw_video.cpp
+++ b/library/borealis/library/lib/platforms/glfw/glfw_video.cpp
@@ -432,6 +432,8 @@
 #elif defined(BOREALIS_USE_D3D11)
     D3D11_CONTEXT->endFrame();
 #endif
+    if (VideoContext::swapCallback)
+        VideoContext::swapCallback();
 }
 
 void GLFWVideoContext::setSwapInterval(int interval)
